# Copy this file to .env and fill in secrets.

CHECKAPP_TOKEN_SECRET=change-me-to-a-long-random-string
CHECKAPP_PORT=8081
CHECKAPP_ADMIN_EMAILS=admin@gmail.com

# Public URL of this site (no trailing slash). Leave empty for local.
# PUBLIC_SITE=http://127.0.0.1:8081

# Discord OAuth
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# DISCORD_REDIRECT_URI=https://your-domain/auth/discord/callback

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://your-domain/auth/google/callback

# Steam Web API (needed for names/avatars)
STEAM_WEB_API_KEY=
